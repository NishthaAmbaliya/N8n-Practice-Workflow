      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const title = String(item.json.Title || \"\").trim();\n  const location = String(item.json.Location || \"\").trim();\n\n  let url = \"https://www.linkedin.com/jobs/search/?\";\n\n  const params = [];\n\n  // Job title / keyword\n  if (title) {\n    params.push(\"keywords=\" + encodeURIComponent(title));\n  }\n\n  // Location\n  if (location) {\n    params.push(\"location=\" + encodeURIComponent(location));\n  }\n\n  url += params.join(\"&\");\n\n  return {\n    json: {\n      ...item.json,\n      linkedinSearchURL: url\n    }\n  };\n});"
      },
