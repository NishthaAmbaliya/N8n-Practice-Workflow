    {
      "parameters": {
        "jsCode": "const data = $input.first()?.json || {};\n\nconsole.log(\"Form data:\", data);\n\n// Get the YouTube URL\nconst rawUrl =\n  data.youtube_url ||\n  data[\"YouTube URL\"] ||\n  data.url ||\n  \"\";\n\n// Check if URL was received\nif (!rawUrl) {\n  throw new Error(\n    \"YouTube URL was not received from the form. Check the Form Trigger Field Name.\"\n  );\n}\n\nconst url = String(rawUrl).trim();\n\nlet videoId = null;\n\n// Normal YouTube URL\nconst watchMatch = url.match(\n  /(?:youtube\\.com\\/watch\\?v=)([a-zA-Z0-9_-]{11})/\n);\n\n// Short YouTube URL\nconst shortMatch = url.match(\n  /(?:youtu\\.be\\/)([a-zA-Z0-9_-]{11})/\n);\n\n// Embedded YouTube URL\nconst embedMatch = url.match(\n  /(?:youtube\\.com\\/embed\\/)([a-zA-Z0-9_-]{11})/\n);\n\nvideoId =\n  watchMatch?.[1] ||\n  shortMatch?.[1] ||\n  embedMatch?.[1] ||\n  null;\n\nif (!videoId) {\n  throw new Error(`Invalid YouTube URL provided: \"${url}\"`);\n}\n\nreturn [\n  {\n    json: {\n      videoId: videoId,\n      originalUrl: url\n    }\n  }\n];"
      },
